      "kind": "id",
      "value": "pit.main-moved-rebase"
    },
    "keywords": [
      "ship",
      "ff",
      "push",
      "rebase",
      "main moved",
      "force-push"
    ],
    "tags": [
      "git"
    ]
  },
  {
    "id": "health-lag",
    "symptom": "Declare done on exit 0 / HTTP 200 too early",
