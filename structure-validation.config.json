{
  "root": ".",
  "structure": {
    "src/app": [
      "page.tsx",
      "layout.tsx",
      "loading.tsx",
      "error.tsx",
      "not-found.tsx",
      "route.ts",
      "globals.css"
    ],
    "src/features": ["*.tsx", "README.md", "AGENTS.md", "KNOWN_ISSUES.md"],
    "src/features/_registry": ["*.ts", "*.json", "README.md"],
    "src/hooks": ["use*.ts"],
    "src/lib": ["*.ts"],
    "src/hubs": ["*.ts"],
    "src/server": ["*.ts"],
    "src/context": ["*.tsx"],
    "src/icons": ["*.svg", "index.tsx"],
    "src/components": ["*.tsx"],
    "db": ["*.sql"],
    "apps": ["README.md", "*.json"],
    "apps/console": ["README.md"],
    "apps/live": ["README.md"],
    "apps/bridge": ["README.md", "FSA.md", "*.json"],
    "apps/bridge/entry": ["*.ts", "README.md"],
    "apps/bridge/adapters": ["*.ts"],
    "apps/bridge/public-api": ["*.ts"],
    "apps/bridge/features": ["**/*"],
    "apps/install": ["README.md", "FSA.md", "*.json"],
    "apps/install/entry": ["README.md"],
    "apps/install/features": ["**/*"],
    "packages": ["README.md"],
    "packages/shared": ["README.md", "package.json", "tsconfig.json"],
    "packages/shared/src": ["**/*.ts"],
    "docs": ["*.md"],
    "docs/adr": ["*.md"],
    "docs/development": ["*.md"],
    "docs/agent-witch": ["*.md"],
    "docs/product": ["*.md"],
    "docs/development": ["*.md"],
    "test": ["*.json", "*.test.ts"],
    "docs/security": ["*.md"],
    "{a}": ["{a}.ts", "{a}.tsx", "{a}.module.css", "{a}.*.ts", "{a}.*.tsx"],
    ".feature-knowledge": ["index.json"],
    ".agents/scripts": ["*.ts"],
    ".agents/scripts/lib": ["*.ts"],
    ".cursor/harness": ["*.json", "*.md"],
    ".cursor/rules": ["*.mdc", "README.md"],
    "{root}": [
      "package.json",
      "tsconfig.json",
      "next.config.ts",
      "README.md",
      "structure-validation.config.json",
      "structure-validation.skip.json",
      "eslint.config.mjs",
      ".prettierignore",
      "postcss.config.mjs",
      "vercel.json",
      ".env.example",
      "CLAUDE.md",
      "AGENTS.md",
      ".gitignore",
      ".cursor.json"
    ],
    "**": [
      "*.test.ts",
      "*.test.tsx",
      "index.ts",
      "index.tsx",
      "presentation.ts",
      "infrastructure.ts",
      "types.ts",
      "*.type.ts",
      "*.constant.ts",
      "*.guardz.ts"
    ]
  }
}
