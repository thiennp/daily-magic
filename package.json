{
  "name": "daily-magic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "npm run build:agent-witch && next build",
    "build:agent-witch": "tsx scripts/buildAgentWitchInstallBundle.ts",
    "vercel-build": "npm run db:migrate && npm run build:agent-witch && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "start:with-migrate": "npm run db:migrate && npm run start",
    "agent-witch": "tsx scripts/agentWitchAppEntry.ts",
    "agent-witch:wake-server": "tsx scripts/agent-witch-wake-server.ts",
    "agent-witch:watchdog": "tsx scripts/agent-witch-watchdog.ts",
    "agent-witch:automation-scheduler": "tsx scripts/agent-witch-automation-scheduler.ts",
    "agent-witch:self-update": "tsx scripts/agent-witch-self-update.ts",
    "agent-witch:test-writer-session-stream": "tsx scripts/testWriterSessionStreamLocal.ts",
    "awl:smoke": "tsx .agents/scripts/dev/startAwlLinuxSmoke.ts",
    "awl:demo:prompt-optimizer-wizard": "tsx .agents/scripts/dev/recordPromptOptimizerAwlLiveWizardDemo.ts",
    "eval:prompt-sdlc": "vitest run .agents/scripts/dev/evalPromptSdlcGoalSuggestions.test.ts .agents/scripts/dev/evalPromptSdlcClassicPrompts.test.ts",
    "agent-witch:install": "bash scripts/install-agent-witch.sh",
    "pretest": "npm run build:agent-witch",
    "test": "vitest run",
    "test:safety": "tsx .agents/scripts/runRefactoringSafetyGate.ts --tier=fast",
    "test:safety:standard": "tsx .agents/scripts/runRefactoringSafetyGate.ts --tier=standard",
    "test:safety:full": "tsx .agents/scripts/runRefactoringSafetyGate.ts --tier=full",
    "test:refactor-gate": "npm run test:safety:standard",
    "harness:script-shims": "tsx .agents/scripts/write-awl-script-shims.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:shipped-install": "playwright test --config=playwright.shipped-install.config.ts",
    "test:shipped-install-blackbox": "tsx scripts/runShippedInstallBlackbox.ts",
    "showcase:capture": "node .agents/scripts/capture-showcase-screens.mjs",
    "portfolio:push-github-io": "bash .agents/scripts/pushThiennpGithubIo.sh",
    "e2e:capture-screenshots": "playwright test --config=playwright.capture.config.ts",
    "e2e:agent-witch:setup": "tsx scripts/e2e-setup-agent-witch-localhost.ts",
    "test:auth:session": "tsx scripts/seedTestAuthSession.ts",
    "lint": "eslint",
    "typecheck": "npm run lint && tsc --noEmit",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backfill-components": "tsx scripts/backfillComponentCatalog.ts",
    "db:migrate:bootstrap": "tsx scripts/db-migrate-bootstrap.ts",
    "db:migrate:onboarding-first-task": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/013-onboarding-first-task-sent.sql",
    "prepare": "npx is-ci || npx husky",
    "harness:bootstrap": "tsx .agents/scripts/harnessBootstrap.ts",
    "harness:sync": "tsx .agents/scripts/harnessBootstrap.ts --write-git-hooks",
    "cursor:verify": "tsx .agents/scripts/verify-rules.ts",
    "cursor:architecture": "tsx .agents/scripts/architecture-check.ts",
    "ci": "npm test && npm run ci:architecture && npm run typecheck && npm run build",
    "ci:architecture": "tsx .agents/scripts/architecture-check.ts --base=origin/main",
    "validate:staged": "sh .agents/scripts/validate-structure-staged.sh",
    "validate:all": "npx structure-validation --scope all --verify-root --skip-error",
    "validate:changes": "npx structure-validation --scope changes --verify-root --skip-error",
    "validate:fix": "structure-validation --scope staged --fix --verify-root",
    "validate:preview": "structure-validation --scope staged --dry-run",
    "feature-knowledge:index": "tsx .agents/scripts/feature-knowledge-index.ts",
    "feature-knowledge:query": "tsx .agents/scripts/feature-knowledge-query.ts",
    "feature-knowledge:scaffold-docs": "tsx .agents/scripts/feature-knowledge-scaffold-docs.ts",
    "storybook:generate": "tsx scripts/generateStorybookPageStories.ts",
    "storybook": "npm run storybook:generate && storybook dev -p 6006",
    "storybook:build": "npm run storybook:generate && storybook build",
    "storybook:wave:init": "tsx scripts/storybookWaveQa/initWaveProgress.ts",
    "storybook:wave:capture": "tsx scripts/storybookWaveQa/captureStorybookPageWave.ts",
    "storybook:wave:capture-all": "tsx scripts/storybookWaveQa/captureAllStorybookPageWaves.ts",
    "storybook:wave:validate": "tsx scripts/storybookWaveQa/validateAllStorybookStories.ts",
    "storybook:wave:objective-gates": "tsx scripts/storybookWaveQa/applyObjectiveWaveQaGates.ts",
    "storybook:wave:weekly": "npm run storybook:build && STORYBOOK_WAVE_OUTPUT_DIR=storybook-wave-captures tsx scripts/storybookWaveQa/runWeeklyStorybookWaveCapture.ts"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.0",
    "@ts-morph/common": {
      "brace-expansion": "5.0.9"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.9"
    },
    "minimatch": {
      "brace-expansion": "1.1.18"
    },
    "browserslist": "4.28.7",
    "js-yaml": "4.3.2",
    "svgo": "3.3.5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.6",
    "@tailwindcss/forms": "^0.5.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apexcharts": "^5.16.0",
    "esbuild": "^0.28.1",
    "flatpickr": "^4.6.13",
    "guardz": "^1.13.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "node-pty": "^1.1.0",
    "pdf-parse": "^1.1.1",
    "react": "19.2.4",
    "react-apexcharts": "^2.1.1",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "resend": "^6.17.2",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.20.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "msw": "^3.0.1",
    "msw-storybook-addon": "^3.0.3",
    "prettier": "^3.6.2",
    "storybook": "^10.6.1",
    "structure-validation": "^0.0.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "5.0.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
