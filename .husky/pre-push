#!/bin/sh
# Git sets GIT_DIR/GIT_WORK_TREE/GIT_* for hooks; nested `git` in vitest would
# otherwise hit this repo instead of mkdtemp sandboxes and hang or mutate HEAD.
repo_root=$(pwd)
git_dir="$repo_root/.git"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_EXEC_PATH GIT_QUARANTINE_PATH GIT_REFLOG_ACTION GIT_TEMPLATE_DIR GIT_CEILING_DIRECTORIES GIT_COMMON_DIR

delete_only=1
saw_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  saw_ref=1
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    delete_only=0
    break
  fi
done

if [ "$saw_ref" = "1" ] && [ "$delete_only" = "1" ]; then
  echo "Skipping CI parity checks (delete-only push)."
  exit 0
fi

echo "Running CI parity checks (npm run ci) before push..."
npm run ci || exit 1
export GIT_DIR="$git_dir"
export GIT_WORK_TREE="$repo_root"
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ]; then
  echo "Syncing main with origin/main after CI (avoid push race)..."
  git checkout -- public/install/agent-witch/app/agent-witch.js public/install/agent-witch/app/deps.tar.gz 2>/dev/null || true
  git fetch origin main
  git rebase origin/main || exit 1
fi
